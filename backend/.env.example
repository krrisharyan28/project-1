# Copy to .env and adjust. Never commit the real .env.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL (required — strict stack, no SQLite fallback) ----
POSTGRES_DB=fraud_dashboard
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- CORS (frontend origin) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- JWT lifetimes (minutes / days) ----
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ---- Ollama / Llama-3 (required) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=60

# ---- Fraud engine thresholds (tunable, no code change needed) ----
FRAUD_HIGH_AMOUNT_THRESHOLD=10000
FRAUD_NEW_CARD_AMOUNT_THRESHOLD=2000
FRAUD_VELOCITY_COUNT=3
FRAUD_VELOCITY_WINDOW_MINUTES=10

# ---- API ----
API_PAGE_SIZE=20
MAX_UPLOAD_MB=10
